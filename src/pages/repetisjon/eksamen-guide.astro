<h3>DORA — DHCP-prosessen</h3>

<img src={`${base}/diagrams/dhcp-dora.svg`} alt="DHCP DORA-prosessen: Discover, Offer, Request, Acknowledge" style="max-width:100%;height:auto;margin:1rem 0;border-radius:10px;border:1px solid var(--border);background:#fff;" />

<div class="eksamen-callout">
  <div class="eksamen-callout-title">Husk til eksamen</div>
